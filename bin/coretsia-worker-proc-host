 * See LICENSE and NOTICE in the project root for full license information.
 */

\error_reporting(\E_ALL);
\ini_set('display_errors', '0');

try {
    $cwd = \getcwd();
    if (!\is_string($cwd) || $cwd === '') {
        throw new \RuntimeException('worker-proc-host-bootstrap-invalid');
    }

    $argv = $_SERVER['argv'] ?? [];
    if (!\is_array($argv) || !\array_is_list($argv) || \count($argv) !== 1) {
        throw new \RuntimeException('worker-proc-host-bootstrap-invalid');
    }

    $autoload = $cwd . '/vendor/autoload.php';
    if (!\is_file($autoload) || !\is_readable($autoload)) {
        throw new \RuntimeException('worker-proc-host-bootstrap-invalid');
    }

    require $autoload;

    $entrypoint = require __DIR__ . '/../src/Process/Entrypoint/worker-proc-host.php';
    if (!\is_callable($entrypoint)) {
        throw new \RuntimeException('worker-proc-host-entrypoint-invalid');
    }

    exit($entrypoint());
} catch (\Throwable) {
    exit(1);
}
