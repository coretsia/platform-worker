use Coretsia\Foundation\Serialization\StableJsonDecoder;
use Coretsia\Foundation\Serialization\StableJsonEncoder;
use Coretsia\Platform\Worker\Process\Proc\WorkerProcProcessHostProtocol;
use Coretsia\Platform\Worker\Process\Proc\WorkerProcProcessHostTransport;

\error_reporting(\E_ALL);
\ini_set('display_errors', '0');

final class CoretsiaWorkerProcHostFailure extends \RuntimeException
{
    public function __construct(
        private readonly string $safeReason,
    ) {
        parent::__construct(self::class);
    }

    public function safeReason(): string
    {
        return $this->safeReason;
    }
}

/**
 * Low-level proc_open host runtime.
 *
 * It owns only opaque process resources and one authenticated guardian
 * connection. Before every proc_open() call, that connection is closed and is
 * replaced afterward through a one-shot authenticated handoff. Worker-pool
 * lifecycle, readiness, state, health, recycle policy, and control-channel
 * semantics remain in the foreground supervisor, while process-generation ownership remains in the guardian.
 */
final class CoretsiaWorkerProcHostRuntime
{
    private const int GRACEFUL_SHUTDOWN_MS = 1_000;
    private const int FORCED_SHUTDOWN_MS = 1_000;
    private const int HANDOFF_CONNECT_TIMEOUT_MS = 1_000;
    private const int LOOP_TICK_US = 50_000;

    /**
     * @var array<string, array{
     *     process: resource,
     *     pid: positive-int,
     *     exit: null|array{
     *         exit_code: non-negative-int,
     *         expected: bool,
     *         pid: positive-int,
     *         signaled: bool,
     *         state: 'exited',
     *         terminating_signal: non-negative-int
     *     }
     * }>
     */
    private array $children = [];

    private int $nextChildId = 1;
    private bool $shutdownRequested = false;
    private bool $signalInterrupted = false;

    public function __construct(
        private readonly WorkerProcProcessHostProtocol $protocol,
        private readonly WorkerProcProcessHostTransport $transport,
        private mixed $connection,
    ) {
        if (!\is_resource($connection)) {
            throw new \InvalidArgumentException('worker-proc-host-runtime-invalid');
        }
    }

    public function run(string $token): int
    {
        $this->installSignalHandlers();
        $buffer = '';
        $authenticated = false;

        try {
            while (!$this->shutdownRequested) {
                $frame = $this->readFrame($buffer);

                if ($frame === null) {
                    if (@\feof($this->connection)) {
                        break;
                    }

                    continue;
                }

                try {
                    $request = $this->protocol->decodeRequest($frame);
                } catch (\Throwable) {
                    break;
                }

                $requestId = $request['request_id'];
                $operation = $request['operation'];

                if (!$authenticated) {
                    if (
                        $operation !== WorkerProcProcessHostProtocol::OPERATION_HELLO
                        || ($request['payload']['token'] ?? null) !== $token
                    ) {
                        $this->writeResponse(
                            $this->protocol->encodeErrorResponse(
                                $requestId,
                                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
                            ),
                        );

                        break;
                    }

                    $authenticated = true;
                    $this->writeResponse(
                        $this->protocol->encodeOkResponse(
                            $requestId,
                            ['ready' => true],
                        ),
                    );

                    continue;
                }

                if ($operation === WorkerProcProcessHostProtocol::OPERATION_SPAWN) {
                    $this->handoffSpawn(
                        requestId: $requestId,
                        payload: $request['payload'],
                    );
                    $buffer = '';

                    continue;
                }

                try {
                    $payload = $this->handle(
                        operation: $operation,
                        payload: $request['payload'],
                    );

                    if ($operation === WorkerProcProcessHostProtocol::OPERATION_SHUTDOWN) {
                        $this->writeResponse(
                            $this->protocol->encodeOkResponse(
                                $requestId,
                                $payload,
                            ),
                        );

                        return 0;
                    }

                    $this->writeResponse(
                        $this->protocol->encodeOkResponse(
                            $requestId,
                            $payload,
                        ),
                    );
                } catch (CoretsiaWorkerProcHostFailure $failure) {
                    $this->writeResponse(
                        $this->protocol->encodeErrorResponse(
                            $requestId,
                            $failure->safeReason(),
                        ),
                    );
                } catch (\Throwable) {
                    $this->writeResponse(
                        $this->protocol->encodeErrorResponse(
                            $requestId,
                            WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
                        ),
                    );
                }
            }

            return 0;
        } finally {
            $this->cleanupChildren();
            $this->uninstallSignalHandlers();

            if (\is_resource($this->connection)) {
                @\fclose($this->connection);
            }
        }
    }

    /**
     * @param array<int|string, mixed> $payload
     *
     * @return array<int|string, mixed>
     */
    private function handle(
        string $operation,
        array $payload,
    ): array {
        return match ($operation) {
            WorkerProcProcessHostProtocol::OPERATION_POLL => $this->poll($payload),
            WorkerProcProcessHostProtocol::OPERATION_TERMINATE => $this->signal($payload, 15),
            WorkerProcProcessHostProtocol::OPERATION_KILL => $this->signal($payload, 9),
            WorkerProcProcessHostProtocol::OPERATION_CLOSE => $this->close($payload),
            WorkerProcProcessHostProtocol::OPERATION_SHUTDOWN => $this->shutdown(),
            default => throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            ),
        };
    }

    /** @param array<int|string, mixed> $payload */
    private function handoffSpawn(
        int $requestId,
        array $payload,
    ): void {
        $handoffPort = $payload['handoff_port'] ?? null;
        $handoffToken = $payload['handoff_token'] ?? null;

        if (
            !\is_int($handoffPort)
            || $handoffPort < 1
            || $handoffPort > 65_535
            || !\is_string($handoffToken)
            || \preg_match('/\A[a-f0-9]{64}\z/', $handoffToken) !== 1
        ) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }

        /*
         * This close is the descriptor-isolation boundary. No authenticated
         * proc-host protocol connection exists while spawn() calls proc_open().
         */
        $this->closeConnection();

        try {
            $responseFrame = $this->protocol->encodeOkResponse(
                $requestId,
                $this->spawn($payload),
            );
        } catch (CoretsiaWorkerProcHostFailure $failure) {
            $responseFrame = $this->protocol->encodeErrorResponse(
                $requestId,
                $failure->safeReason(),
            );
        } catch (\Throwable) {
            $responseFrame = $this->protocol->encodeErrorResponse(
                $requestId,
                WorkerProcProcessHostProtocol::ERROR_CHILD_START_FAILED,
            );
        }

        try {
            $this->connection = $this->transport->connect(
                port: $handoffPort,
                timeoutMs: self::HANDOFF_CONNECT_TIMEOUT_MS,
            );

            $this->writeResponse(
                $this->protocol->encodeHandoff(
                    requestId: $requestId,
                    handoffToken: $handoffToken,
                    responseFrame: $responseFrame,
                ),
            );
        } catch (\Throwable) {
            /*
             * The guardian cannot identify a child whose handoff failed. Let
             * run() unwind so its finally block terminates and reaps every child
             * before the process host exits non-zero.
             */
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }
    }

    /**
     * @param array<int|string, mixed> $payload
     *
     * @return array{child_id: non-empty-string, pid: positive-int}
     */
    private function spawn(array $payload): array
    {
        $command = $payload['command'] ?? null;
        $workingDirectory = $payload['working_directory'] ?? null;

        if (
            !\is_array($command)
            || !\array_is_list($command)
            || $command === []
            || !\is_string($workingDirectory)
            || $workingDirectory === ''
        ) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_CHILD_START_FAILED,
            );
        }

        $null = \PHP_OS_FAMILY === 'Windows'
            ? 'NUL'
            : '/dev/null';

        $descriptors = [
            0 => ['file', $null, 'r'],
            1 => ['file', $null, 'w'],
            2 => ['file', $null, 'w'],
        ];

        /** @var array{bypass_shell: true, create_process_group?: true} $options */
        $options = [
            'bypass_shell' => true,
        ];

        if (\PHP_OS_FAMILY === 'Windows') {
            $options['create_process_group'] = true;
        }

        $pipes = [];
        $process = @\proc_open(
            command: $command,
            descriptor_spec: $descriptors,
            pipes: $pipes,
            cwd: $workingDirectory,
            env_vars: null,
            options: $options,
        );

        if (!\is_resource($process)) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_CHILD_START_FAILED,
            );
        }

        $status = @\proc_get_status($process);

        if (
            !\is_array($status)
            || ($status['running'] ?? false) !== true
            || !\is_int($status['pid'] ?? null)
            || $status['pid'] < 1
        ) {
            @\proc_terminate($process, 9);
            @\proc_close($process);

            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_CHILD_START_FAILED,
            );
        }

        if ($this->nextChildId > 2_147_483_647) {
            @\proc_terminate($process, 9);
            @\proc_close($process);

            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }

        $childId = 'child-' . $this->nextChildId++;
        $this->children[$childId] = [
            'process' => $process,
            'pid' => $status['pid'],
            'exit' => null,
        ];

        return [
            'child_id' => $childId,
            'pid' => $status['pid'],
        ];
    }

    /**
     * @param array<int|string, mixed> $payload
     *
     * @return array<int|string, mixed>
     */
    private function poll(array $payload): array
    {
        $childId = $this->childId($payload);
        $exit = $this->refreshExit($childId);

        return $exit ?? ['state' => 'running'];
    }

    /**
     * @param array<int|string, mixed> $payload
     *
     * @return array{acknowledged: true}
     */
    private function signal(array $payload, int $signal): array
    {
        $childId = $this->childId($payload);
        $entry = $this->children[$childId];

        if ($entry['exit'] === null) {
            $status = @\proc_get_status($entry['process']);

            if (
                \is_array($status)
                && ($status['running'] ?? false) === true
                && !@\proc_terminate($entry['process'], $signal)
            ) {
                throw new CoretsiaWorkerProcHostFailure(
                    WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
                );
            }
        }

        return ['acknowledged' => true];
    }

    /**
     * @param array<int|string, mixed> $payload
     *
     * @return array{acknowledged: true}
     */
    private function close(array $payload): array
    {
        $childId = $this->childId($payload);
        $exit = $this->refreshExit($childId);

        if ($exit === null) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_CHILD_RUNNING,
            );
        }

        @\proc_close($this->children[$childId]['process']);
        unset($this->children[$childId]);

        return ['acknowledged' => true];
    }

    /** @return array{acknowledged: true} */
    private function shutdown(): array
    {
        /*
         * Acknowledge the lifecycle request before performing fallback cleanup.
         * run() writes the terminal host response and then its finally block
         * terminates and reaps any remaining process resources.
         */
        $this->shutdownRequested = true;

        return ['acknowledged' => true];
    }

    /**
     * @return null|array{
     *     exit_code: non-negative-int,
     *     expected: bool,
     *     pid: positive-int,
     *     signaled: bool,
     *     state: 'exited',
     *     terminating_signal: non-negative-int
     * }
     */
    private function refreshExit(string $childId): ?array
    {
        $entry = $this->children[$childId];

        if ($entry['exit'] !== null) {
            return $entry['exit'];
        }

        $status = @\proc_get_status($entry['process']);

        if (!\is_array($status)) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }

        if (($status['running'] ?? false) === true) {
            return null;
        }

        $reportedSignal = $status['termsig'] ?? null;
        $signaled = ($status['signaled'] ?? false) === true
            && \is_int($reportedSignal)
            && $reportedSignal > 0;
        $terminatingSignal = $signaled
            ? $reportedSignal
            : 0;
        $exitCode = \is_int($status['exitcode'] ?? null)
        && $status['exitcode'] >= 0
            ? $status['exitcode']
            : ($signaled ? 128 + $terminatingSignal : 1);

        $exit = [
            'exit_code' => $exitCode,
            'expected' => !$signaled && $exitCode === 0,
            'pid' => $entry['pid'],
            'signaled' => $signaled,
            'state' => 'exited',
            'terminating_signal' => $terminatingSignal,
        ];

        $this->children[$childId]['exit'] = $exit;

        return $exit;
    }

    /** @param array<int|string, mixed> $payload */
    private function childId(array $payload): string
    {
        $childId = $payload['child_id'] ?? null;

        if (
            !\is_string($childId)
            || !isset($this->children[$childId])
        ) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_CHILD_INVALID,
            );
        }

        return $childId;
    }

    private function cleanupChildren(): void
    {
        if ($this->children === []) {
            return;
        }

        foreach (\array_keys($this->children) as $childId) {
            try {
                $this->signal(['child_id' => $childId], 15);
            } catch (\Throwable) {
            }
        }

        $this->waitForChildren(self::GRACEFUL_SHUTDOWN_MS);

        foreach (\array_keys($this->children) as $childId) {
            try {
                if ($this->refreshExit($childId) === null) {
                    $this->signal(['child_id' => $childId], 9);
                }
            } catch (\Throwable) {
            }
        }

        $this->waitForChildren(self::FORCED_SHUTDOWN_MS);

        foreach ($this->children as $entry) {
            $status = @\proc_get_status($entry['process']);

            if (
                \is_array($status) && ($status['running'] ?? false) === true
            ) {
                @\proc_terminate($entry['process'], 9);
            }

            @\proc_close($entry['process']);
        }

        $this->children = [];
    }

    private function waitForChildren(int $timeoutMs): void
    {
        $deadlineNs = \hrtime(true) + ($timeoutMs * 1_000_000);

        do {
            $allExited = true;

            foreach (\array_keys($this->children) as $childId) {
                try {
                    if ($this->refreshExit($childId) === null) {
                        $allExited = false;
                    }
                } catch (\Throwable) {
                    $allExited = false;
                }
            }

            if ($allExited) {
                return;
            }

            \usleep(10_000);
        } while (\hrtime(true) < $deadlineNs);
    }

    private function closeConnection(): void
    {
        if (\is_resource($this->connection)) {
            @\fclose($this->connection);
        }

        $this->connection = null;
    }

    private function readFrame(string &$buffer): ?string
    {
        if (!\is_resource($this->connection)) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }

        $read = [$this->connection];
        $write = null;
        $except = null;

        $selected = @\stream_select(
            $read,
            $write,
            $except,
            0,
            self::LOOP_TICK_US,
        );

        if ($selected === 0) {
            /*
             * A handled signal may not interrupt stream_select() on every platform.
             * Do not carry the interruption marker into an unrelated later failure.
             */
            $this->signalInterrupted = false;

            return null;
        }

        if ($selected !== 1) {
            if (
                $this->shutdownRequested
                || $this->signalInterrupted
            ) {
                $this->signalInterrupted = false;

                return null;
            }

            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }

        $remaining = WorkerProcProcessHostProtocol::MAX_FRAME_BYTES
            + 1
            - \strlen($buffer);

        if ($remaining < 1) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }

        $chunk = @\fread($this->connection, $remaining);

        if ($chunk === false) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }

        if ($chunk === '') {
            return null;
        }

        $buffer .= $chunk;
        $newline = \strpos($buffer, "\n");

        if ($newline === false) {
            return null;
        }

        $frame = \substr($buffer, 0, $newline + 1);
        $buffer = \substr($buffer, $newline + 1);

        return $frame;
    }

    private function writeResponse(string $frame): void
    {
        if (!\is_resource($this->connection)) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }

        $remaining = $frame;

        while ($remaining !== '') {
            $written = @\fwrite(
                $this->connection,
                $remaining,
            );

            if (!\is_int($written) || $written < 1) {
                throw new CoretsiaWorkerProcHostFailure(
                    WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
                );
            }

            $remaining = \substr($remaining, $written);
        }

        if (!@\fflush($this->connection)) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }
    }

    private function installSignalHandlers(): void
    {
        if (\PHP_OS_FAMILY === 'Windows') {
            if (
                !\function_exists('sapi_windows_set_ctrl_handler')
                || !@\sapi_windows_set_ctrl_handler(
                    function (int $_event): void {
                        /*
                         * The guardian owns proc-host lifecycle semantics. The host prevents
                         * service-unit control events from bypassing guardian-owned poll,
                         * terminate, kill, close and shutdown operations.
                         */
                        $this->signalInterrupted = true;
                    },
                    true,
                )
            ) {
                throw new CoretsiaWorkerProcHostFailure(
                    WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
                );
            }

            return;
        }

        if (
            !\function_exists('pcntl_async_signals')
            || !\function_exists('pcntl_signal')
            || !\defined('SIGTERM')
            || !\defined('SIGINT')
        ) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }

        \pcntl_async_signals(true);

        $handler = function (): void {
            /*
             * A service manager may signal the complete process group/cgroup. The
             * host must remain available to its guardian for poll, terminate, kill,
             * close and shutdown operations while the guardian connection is alive.
             */
            $this->signalInterrupted = true;
        };

        if (
            !\pcntl_signal(\SIGTERM, $handler, true)
            || !\pcntl_signal(\SIGINT, $handler, true)
        ) {
            throw new CoretsiaWorkerProcHostFailure(
                WorkerProcProcessHostProtocol::ERROR_OPERATION_FAILED,
            );
        }
    }

    private function uninstallSignalHandlers(): void
    {
        if (\PHP_OS_FAMILY === 'Windows') {
            return;
        }

        if (
            \function_exists('pcntl_signal')
            && \defined('SIGTERM')
            && \defined('SIGINT')
            && \defined('SIG_DFL')
        ) {
            @\pcntl_signal(\SIGTERM, \SIG_DFL, true);
            @\pcntl_signal(\SIGINT, \SIG_DFL, true);
        }

        if (\function_exists('pcntl_async_signals')) {
            @\pcntl_async_signals(false);
        }
    }
}

/** @return array{port: int<1, 65535>, token: non-empty-string} */
function coretsia_worker_proc_host_parse_args(array $argv): array
{
    if (!\array_is_list($argv) || $argv === []) {
        throw new CoretsiaWorkerProcHostFailure('argv-invalid');
    }

    $values = [];

    foreach (\array_slice($argv, 1) as $argument) {
        if (
            !\is_string($argument)
            || \preg_match('/[\x00-\x1F\x7F]/', $argument) === 1
        ) {
            throw new CoretsiaWorkerProcHostFailure('argv-invalid');
        }

        $separator = \strpos($argument, '=');

        if (
            $separator === false
            || !\str_starts_with($argument, '--coretsia-proc-host-')
        ) {
            throw new CoretsiaWorkerProcHostFailure('argv-invalid');
        }

        $key = \substr($argument, 2, $separator - 2);
        $value = \substr($argument, $separator + 1);

        if ($key === '' || $value === '' || isset($values[$key])) {
            throw new CoretsiaWorkerProcHostFailure('argv-invalid');
        }

        $values[$key] = $value;
    }

    if (
        \array_keys($values) !== [
            'coretsia-proc-host-port',
            'coretsia-proc-host-token',
        ]
        || !\ctype_digit($values['coretsia-proc-host-port'])
        || \preg_match('/\A[a-f0-9]{64}\z/', $values['coretsia-proc-host-token']) !== 1
    ) {
        throw new CoretsiaWorkerProcHostFailure('argv-invalid');
    }

    $port = (int)$values['coretsia-proc-host-port'];

    if ($port < 1 || $port > 65_535) {
        throw new CoretsiaWorkerProcHostFailure('argv-invalid');
    }

    return [
        'port' => $port,
        'token' => $values['coretsia-proc-host-token'],
    ];
}

function coretsia_worker_proc_host_require_autoload(string $root): void
{
    $autoload = $root . '/vendor/autoload.php';

    if (!\is_file($autoload) || !\is_readable($autoload)) {
        throw new CoretsiaWorkerProcHostFailure('autoload-invalid');
    }

    require $autoload;
}

try {
    $cwd = \getcwd();

    if (!\is_string($cwd) || $cwd === '') {
        throw new CoretsiaWorkerProcHostFailure('cwd-invalid');
    }

    $args = coretsia_worker_proc_host_parse_args(
        $_SERVER['argv'] ?? [],
    );

    coretsia_worker_proc_host_require_autoload($cwd);

    $protocol = new WorkerProcProcessHostProtocol(
        new StableJsonEncoder(),
        new StableJsonDecoder(),
    );

    $transport = new WorkerProcProcessHostTransport();

    $runtime = new CoretsiaWorkerProcHostRuntime(
        protocol: $protocol,
        transport: $transport,
        connection: $transport->accept($args['port']),
    );

    exit($runtime->run($args['token']));
} catch (\Throwable) {
    exit(1);
}
