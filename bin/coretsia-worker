use Coretsia\Contracts\Config\ConfigRepositoryInterface;
use Coretsia\Kernel\Boot\ArtifactRuntimeBooter;
use Coretsia\Kernel\Boot\ArtifactRuntimeInput;
use Coretsia\Kernel\Module\ModulePlan;
use Coretsia\Kernel\Runtime\Exception\RuntimeDriverConflictException;
use Coretsia\Kernel\Runtime\Exception\RuntimeDriverInvalidConfigException;
use Coretsia\Platform\Worker\Exception\WorkerStartFailedException;
use Coretsia\Platform\Worker\Runtime\WorkerPoolSpec;
use Coretsia\Platform\Worker\Runtime\WorkerRuntimeEntrypointGuard;
use Coretsia\Platform\Worker\Worker\ApplicationWorker;
use Psr\Container\ContainerInterface;

\error_reporting(\E_ALL);
\ini_set('display_errors', '0');

/**
 * Local deterministic launcher failure.
 *
 * This exception is intentionally local to the launcher. The reason is a safe
 * stable token controlled by this file only.
 */
final class CoretsiaWorkerChildBootFailure extends \RuntimeException
{
    public function __construct(
        private readonly string $safeReason,
    ) {
        parent::__construct(self::class);
    }

    public function safeReason(): string
    {
        return $this->safeReason;
    }
}

/**
 * Terminates after a deterministic internal boot failure.
 *
 * The launcher emits no stdout/stderr output. The supervisor observes the
 * child exit and maps it to package-owned deterministic failures.
 */
function coretsia_worker_child_fail(
    string $_reason,
): never {
    exit(1);
}

/**
 * Throws a local safe failure.
 */
function coretsia_worker_child_throw(string $reason): never
{
    throw new CoretsiaWorkerChildBootFailure($reason);
}

/**
 * @return array{
 *     index: int,
 *     count: int,
 *     max_requests: int,
 *     task_type: string,
 *     driver: string,
 *     artifact_root: string,
 *     readiness_port: int,
 *     readiness_token: string
 * }
 */
function coretsia_worker_child_parse_args(array $argv): array
{
    if (!\array_is_list($argv) || $argv === []) {
        coretsia_worker_child_throw('argv-invalid');
    }

    $values = [];

    foreach (\array_slice($argv, 1) as $token) {
        if (!\is_string($token) || $token === '') {
            coretsia_worker_child_throw('argv-invalid');
        }

        if (\preg_match('/[\x00-\x1F\x7F]/', $token) === 1) {
            coretsia_worker_child_throw('argv-invalid');
        }

        if (!\str_starts_with($token, '--coretsia-worker-')) {
            coretsia_worker_child_throw('argv-invalid');
        }

        $separator = \strpos($token, '=');
        if ($separator === false || $separator < 1) {
            coretsia_worker_child_throw('argv-invalid');
        }

        $key = \substr($token, 2, $separator - 2);
        $value = \substr($token, $separator + 1);

        if ($key === '' || $value === '') {
            coretsia_worker_child_throw('argv-invalid');
        }

        if (isset($values[$key])) {
            coretsia_worker_child_throw('argv-invalid');
        }

        $values[$key] = $value;
    }

    $required = [
        'coretsia-worker-index',
        'coretsia-worker-count',
        'coretsia-worker-max-requests',
        'coretsia-worker-task-type',
        'coretsia-worker-driver',
        'coretsia-worker-artifact-root',
        'coretsia-worker-readiness-port',
        'coretsia-worker-readiness-token',
    ];

    foreach ($required as $key) {
        if (!isset($values[$key]) || !\is_string($values[$key])) {
            coretsia_worker_child_throw('argv-invalid');
        }
    }

    foreach (\array_keys($values) as $key) {
        if (!\in_array($key, $required, true)) {
            coretsia_worker_child_throw('argv-invalid');
        }
    }

    $index = coretsia_worker_child_non_negative_int($values['coretsia-worker-index']);
    $count = coretsia_worker_child_positive_int($values['coretsia-worker-count']);
    $maxRequests = coretsia_worker_child_positive_int($values['coretsia-worker-max-requests']);
    $taskType = $values['coretsia-worker-task-type'];
    $driver = $values['coretsia-worker-driver'];
    $artifactRoot = $values['coretsia-worker-artifact-root'];
    $readinessPort = coretsia_worker_child_positive_int(
        $values['coretsia-worker-readiness-port'],
    );
    $readinessToken = $values['coretsia-worker-readiness-token'];

    if (
        $readinessPort > 65535
        || \preg_match(
            '/\A[a-f0-9]{64}\z/',
            $readinessToken,
        ) !== 1
    ) {
        coretsia_worker_child_throw('argv-invalid');
    }

    if ($index >= $count) {
        coretsia_worker_child_throw('argv-invalid');
    }

    if ($taskType !== 'queue' && $taskType !== 'http') {
        coretsia_worker_child_throw('argv-invalid');
    }

    if ($driver !== 'pcntl' && $driver !== 'proc') {
        coretsia_worker_child_throw('argv-invalid');
    }

    if (!coretsia_worker_child_is_relative_safe_path($artifactRoot)) {
        coretsia_worker_child_throw('argv-invalid');
    }

    return [
        'index' => $index,
        'count' => $count,
        'max_requests' => $maxRequests,
        'task_type' => $taskType,
        'driver' => $driver,
        'artifact_root' => $artifactRoot,
        'readiness_port' => $readinessPort,
        'readiness_token' => $readinessToken,
    ];
}

function coretsia_worker_child_non_negative_int(string $value): int
{
    if ($value === '' || !\ctype_digit($value)) {
        coretsia_worker_child_throw('argv-invalid');
    }

    $int = \filter_var($value, \FILTER_VALIDATE_INT);
    if (!\is_int($int) || $int < 0) {
        coretsia_worker_child_throw('argv-invalid');
    }

    return $int;
}

function coretsia_worker_child_positive_int(string $value): int
{
    $int = coretsia_worker_child_non_negative_int($value);

    if ($int < 1) {
        coretsia_worker_child_throw('argv-invalid');
    }

    return $int;
}

function coretsia_worker_child_normalize_skeleton_root(string $root): string
{
    $root = \trim($root);

    if ($root === '' || \str_contains($root, "\0")) {
        coretsia_worker_child_throw('cwd-invalid');
    }

    $root = \rtrim(\str_replace('\\', '/', $root), '/');

    if ($root === '') {
        coretsia_worker_child_throw('cwd-invalid');
    }

    return $root;
}

function coretsia_worker_child_is_relative_safe_path(string $path): bool
{
    if (
        $path === ''
        || \trim($path) !== $path
        || \preg_match('/[\x00-\x1F\x7F]/', $path) === 1
        || \preg_match('/\s/u', $path) !== 0
    ) {
        return false;
    }

    if (\str_starts_with($path, '/') || \str_starts_with($path, '\\')) {
        return false;
    }

    if (\preg_match('/\A[A-Za-z]:[\/\\\\]/', $path) === 1) {
        return false;
    }

    if (\str_contains($path, '\\')) {
        return false;
    }

    if (\str_contains($path, '://')) {
        return false;
    }

    if (\str_contains($path, '//')) {
        return false;
    }

    foreach (\explode('/', $path) as $segment) {
        if ($segment === '' || $segment === '.' || $segment === '..') {
            return false;
        }

        if (\str_starts_with($segment, '@')) {
            return false;
        }
    }

    return true;
}

function coretsia_worker_child_resolve_relative_path(string $skeletonRoot, string $relativePath): string
{
    if (!coretsia_worker_child_is_relative_safe_path($relativePath)) {
        coretsia_worker_child_throw('path-invalid');
    }

    return $skeletonRoot . '/' . $relativePath;
}

function coretsia_worker_child_require_autoload(string $skeletonRoot): void
{
    $autoloadFile = $skeletonRoot . '/vendor/autoload.php';

    \set_error_handler(static fn (): bool => true);

    try {
        if (!\is_file($autoloadFile) || !\is_readable($autoloadFile)) {
            coretsia_worker_child_throw('autoload-missing');
        }

        require $autoloadFile;
    } catch (CoretsiaWorkerChildBootFailure $exception) {
        throw $exception;
    } catch (\Throwable) {
        coretsia_worker_child_throw('autoload-invalid');
    } finally {
        \restore_error_handler();
    }
}

function coretsia_worker_child_boot_container(
    string $skeletonRoot,
    string $artifactRoot,
): ContainerInterface {
    try {
        return new ArtifactRuntimeBooter()->boot(
            input: new ArtifactRuntimeInput(
                skeletonRoot: $skeletonRoot,
                artifactRoot: $artifactRoot,
            ),
        );
    } catch (\Throwable) {
        coretsia_worker_child_throw('runtime-container-boot-failed');
    }
}

/**
 * @template T of object
 *
 * @param class-string<T> $id
 *
 * @return T
 */
function coretsia_worker_child_service(ContainerInterface $container, string $id): object
{
    try {
        $service = $container->get($id);
    } catch (\Throwable) {
        coretsia_worker_child_throw('service-unresolvable');
    }

    if (!$service instanceof $id) {
        coretsia_worker_child_throw('service-invalid');
    }

    return $service;
}

function coretsia_worker_child_assert_runtime_entrypoint_allowed(
    ContainerInterface $container,
    WorkerPoolSpec $spec
): void {
    try {
        /** @var WorkerRuntimeEntrypointGuard $guard */
        $guard = coretsia_worker_child_service($container, WorkerRuntimeEntrypointGuard::class);

        /** @var ConfigRepositoryInterface $config */
        $config = coretsia_worker_child_service($container, ConfigRepositoryInterface::class);

        /** @var ModulePlan $modulePlan */
        $modulePlan = coretsia_worker_child_service($container, ModulePlan::class);

        $guard->assertEntrypointAllowed(
            config: $config,
            modulePlan: $modulePlan,
            spec: $spec,
        );
    } catch (RuntimeDriverConflictException|RuntimeDriverInvalidConfigException) {
        coretsia_worker_child_throw('runtime-driver-incompatible');
    } catch (WorkerStartFailedException $exception) {
        if (
            $exception->reason()
            === WorkerStartFailedException::REASON_MODULE_NOT_ENABLED
        ) {
            coretsia_worker_child_throw('runtime-entrypoint-incompatible');
        }

        coretsia_worker_child_throw('runtime-entrypoint-guard-failed');
    } catch (CoretsiaWorkerChildBootFailure $exception) {
        throw $exception;
    } catch (\Throwable) {
        coretsia_worker_child_throw('runtime-entrypoint-guard-failed');
    }
}

function coretsia_worker_child_ignore_windows_ctrl_event(
    int $_event,
): void {
}

/**
 * Ensures that supervisor-owned Windows CTRL events do not terminate the
 * proc child independently of the supervisor lifecycle.
 */
function coretsia_worker_child_install_windows_ctrl_isolation(): void
{
    if (\PHP_OS_FAMILY !== 'Windows') {
        return;
    }

    if (
        !\function_exists('sapi_windows_set_ctrl_handler')
        || !\defined('PHP_WINDOWS_EVENT_CTRL_C')
        || !\defined('PHP_WINDOWS_EVENT_CTRL_BREAK')
        || !@\sapi_windows_set_ctrl_handler('coretsia_worker_child_ignore_windows_ctrl_event', true)
    ) {
        coretsia_worker_child_throw('windows-ctrl-handler-unavailable');
    }
}

function coretsia_worker_child_signal_ready(
    int $port,
    string $token,
): void {
    if (
        $port < 1
        || $port > 65535
        || \preg_match('/\A[a-f0-9]{64}\z/', $token) !== 1
    ) {
        coretsia_worker_child_throw('readiness-channel-unavailable');
    }

    $stream = @\stream_socket_client(
        'tcp://127.0.0.1:' . $port,
        $errorCode,
        $errorMessage,
        1.0,
        \STREAM_CLIENT_CONNECT,
    );

    if (!\is_resource($stream)) {
        coretsia_worker_child_throw('readiness-channel-unavailable');
    }

    if (!@\stream_set_timeout($stream, 1, 0)) {
        @\fclose($stream);

        coretsia_worker_child_throw('readiness-channel-unavailable');
    }

    $remaining = 'ready:' . $token . "\n";

    try {
        while ($remaining !== '') {
            $written = @\fwrite(
                $stream,
                $remaining,
            );

            if (!\is_int($written) || $written < 1) {
                coretsia_worker_child_throw('readiness-channel-write-failed');
            }

            $remaining = \substr(
                $remaining,
                $written,
            );
        }

        if (!@\fflush($stream)) {
            coretsia_worker_child_throw('readiness-channel-write-failed');
        }
    } finally {
        @\fclose($stream);
    }
}

/**
 * @param array{
 *     index: int,
 *     count: int,
 *     max_requests: int,
 *     task_type: string,
 *     driver: string,
 *     artifact_root: string,
 *     readiness_port: int,
 *     readiness_token: non-empty-string
 * } $args
 */

function coretsia_worker_child_assert_args_match_spec(array $args, WorkerPoolSpec $spec): void
{
    if ($args['count'] !== $spec->workers()) {
        coretsia_worker_child_throw('worker-args-mismatch');
    }

    if ($args['max_requests'] !== $spec->maxRequests()) {
        coretsia_worker_child_throw('worker-args-mismatch');
    }

    if ($args['task_type'] !== $spec->taskType()) {
        coretsia_worker_child_throw('worker-args-mismatch');
    }

    if ($args['driver'] !== $spec->driver()) {
        coretsia_worker_child_throw('worker-args-mismatch');
    }
}

try {
    $cwd = \getcwd();

    if (!\is_string($cwd)) {
        coretsia_worker_child_throw('cwd-invalid');
    }

    $skeletonRoot = coretsia_worker_child_normalize_skeleton_root($cwd);
    $args = coretsia_worker_child_parse_args($_SERVER['argv'] ?? []);
    coretsia_worker_child_install_windows_ctrl_isolation();

    coretsia_worker_child_require_autoload($skeletonRoot);

    $artifactRoot = coretsia_worker_child_resolve_relative_path(
        skeletonRoot: $skeletonRoot,
        relativePath: $args['artifact_root'],
    );

    $container = coretsia_worker_child_boot_container(
        skeletonRoot: $skeletonRoot,
        artifactRoot: $artifactRoot,
    );

    /** @var WorkerPoolSpec $spec */
    $spec = coretsia_worker_child_service($container, WorkerPoolSpec::class);

    coretsia_worker_child_assert_args_match_spec($args, $spec);

    coretsia_worker_child_assert_runtime_entrypoint_allowed(
        container: $container,
        spec: $spec,
    );

    /** @var ApplicationWorker $worker */
    $worker = coretsia_worker_child_service($container, ApplicationWorker::class);

    $worker->assertReady(
        $spec,
        $args['index'],
    );

    coretsia_worker_child_signal_ready(
        port: $args['readiness_port'],
        token: $args['readiness_token'],
    );

    $worker->run(
        $spec,
        $args['index'],
    );

    exit(0);
} catch (CoretsiaWorkerChildBootFailure $exception) {
    coretsia_worker_child_fail($exception->safeReason());
} catch (\Throwable) {
    coretsia_worker_child_fail('worker-child-failed');
}
